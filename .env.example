# Copy to .env for local development: cp .env.example .env
# .env is git-ignored. Never commit real keys.

# Dev defaults work without these; production (config.settings.prod) requires SECRET_KEY and DATABASE_URL.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://climate:climate@localhost:5432/climate

# LLM chat (optional: without a key the chat endpoint returns 503 and the rest of the app works).
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
